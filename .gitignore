# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.env

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Claude Code: personal permission overrides stay local; worktrees of
# execution sessions live under the checkout and are never committed
.claude/settings.local.json
.claude/worktrees/
# What scripts/dev/ui_snap.py (/ui-check) writes by default: PNGs of the plate page
/.claude/ui-check/

# Experimental data and model weights are never committed
/data/
*.nd2
*.czi
*.tif
*.tiff
*.zarr/
*.pth
*.pt
*.ckpt

# Micro-Manager logs and per-machine configs (profiles/ are committed; site
# .cfg files that embed COM ports and serial numbers are not)
CoreLog*.txt
/local/

# What write_atomically keeps when only the final rename failed (Windows: an editor
# holds the file), e.g. profiles/.nikon-ti2.toml.<token>.smc-tmp after
# `smc objective offset --write`: the whole new text, not to be committed
*.smc-tmp
